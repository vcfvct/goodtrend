{
  "system": {
    "theme": "eve",
    "file_storage": "s3",
    "extensions": [
      {
        "name": "s3_file_storage",
        "resolve": "node_modules/@evershop/s3_file_storage",
        "enabled": true,
        "priority": 10
      },
      {
        "name": "contact",
        "resolve": "extensions/contact",
        "enabled": true,
        "priority": 20
      },
      {
        "name": "better-menu",
        "resolve": "extensions/better-menu",
        "enabled": true,
        "priority": 30
      }
    ]
  },
  "themeConfig": {
    "headTags": {
      "links": [
        {
          "rel": "icon",
          "href": "/favicon.ico",
          "type": "image/x-icon"
        }
      ]
    }
  }
}
